@page "/cocina"
@attribute [Authorize(Policy = Policies.UseKitchen)]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using TPVBar.Application.Features.Kitchen
@using TPVBar.Domain.Catalog
@using TPVBar.Domain.Sales
@inject UseCaseRunner Runner
@inject OperationEventBus Bus
@inject IJSRuntime JS

<PageTitle>Cocina · TPVBar</PageTitle>

<main class="kds">
    <div class="kds__bar">
        <h1>Cocina</h1>
        <div class="kds__filters" role="tablist" aria-label="Destino">
            <button type="button" role="tab" aria-selected="@(_station is null)" class="category @(_station is null ? "category--active" : "")" @onclick="() => SetStationAsync(null)">Todo</button>
            <button type="button" role="tab" aria-selected="@(_station == PreparationStation.Kitchen)" class="category @(_station == PreparationStation.Kitchen ? "category--active" : "")" @onclick="() => SetStationAsync(PreparationStation.Kitchen)">Cocina</button>
            <button type="button" role="tab" aria-selected="@(_station == PreparationStation.Bar)" class="category @(_station == PreparationStation.Bar ? "category--active" : "")" @onclick="() => SetStationAsync(PreparationStation.Bar)">Barra</button>
        </div>
        <label class="check"><input type="checkbox" @bind="_sound" /> Aviso sonoro</label>
    </div>

    @if (_error is not null)
    {
        <p class="alert alert--error" role="alert">@_error</p>
    }

    @if (_tickets is null)
    {
        <p>Cargando…</p>
    }
    else
    {
        <div class="kds__columns">
            @foreach (var (status, title) in Columns)
            {
                var column = _tickets.Where(t => t.Status == status).ToList();
                <section class="kds__column kds__column--@status.ToString().ToLowerInvariant()" aria-labelledby="col-@status">
                    <h2 id="col-@status">@title <span class="badge">@column.Count</span></h2>

                    @if (column.Count == 0)
                    {
                        <p class="muted">Sin pedidos.</p>
                    }

                    @foreach (var ticket in column)
                    {
                        var minutes = (int)(_now - ticket.SentAt).TotalMinutes;
                        <article class="kds__ticket @(minutes >= 10 ? "kds__ticket--late" : "")">
                            <header>
                                <strong class="kds__table">@ticket.TableLabel</strong>
                                <span class="badge">@(ticket.Station == PreparationStation.Bar ? "Barra" : "Cocina")</span>
                                <span class="kds__age">
                                    @if (minutes >= 10) { <span>⚠ Retraso · </span> }
                                    hace @minutes min
                                </span>
                            </header>
                            <ul>
                                @foreach (var line in ticket.Lines)
                                {
                                    <li class="@(line.IsCancelled ? "kds__line--cancelled" : "")">
                                        <span class="kds__qty">@line.Quantity.ToString("0.###")×</span>
                                        <span>@line.Name</span>
                                        @if (line.IsCancelled) { <strong class="kds__void"> ANULADO</strong> }
                                        @if (!string.IsNullOrEmpty(line.Notes)) { <em class="kds__notes">«@line.Notes»</em> }
                                    </li>
                                }
                            </ul>
                            <button type="button" class="btn btn--primary btn--big" disabled="@_busy" @onclick="() => AdvanceAsync(ticket)">
                                @NextLabel(ticket.Status)
                            </button>
                        </article>
                    }
                </section>
            }
        </div>
    }
</main>

@code {
    private static readonly (KitchenTicketStatus Status, string Title)[] Columns =
    [
        (KitchenTicketStatus.Pending, "Pendiente"),
        (KitchenTicketStatus.Preparing, "Preparando"),
        (KitchenTicketStatus.Ready, "Preparado"),
    ];

    private IReadOnlyList<KitchenTicketView>? _tickets;
    private PreparationStation? _station;
    private string? _error;
    private bool _busy;
    private bool _sound;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private HashSet<long> _known = [];
    private bool _firstLoad = true;
    private IDisposable? _subscription;
    private Timer? _timer;
    private int _reloadPending;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _subscription = Bus.Subscribe(OnEventAsync);

        // Respaldo y reloj de antigüedad: relee cada 30 s y refresca los minutos transcurridos.
        _timer = new Timer(_ => _ = ScheduleReloadAsync(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private Task OnEventAsync(OperationEvent e) =>
        e.Name is OperationEventNames.KitchenTicketCreated or OperationEventNames.KitchenTicketStatusChanged
            ? ScheduleReloadAsync()
            : Task.CompletedTask;

    private async Task ScheduleReloadAsync()
    {
        if (Interlocked.Exchange(ref _reloadPending, 1) == 1)
        {
            return;
        }

        await Task.Delay(100);
        Interlocked.Exchange(ref _reloadPending, 0);
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        var station = _station;
        var result = await Runner.RunAsync<KitchenService, IReadOnlyList<KitchenTicketView>>((s, ct) => s.GetBoardAsync(station, ct));
        _now = DateTimeOffset.UtcNow;
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        _tickets = result.Value;

        // Aviso sonoro solo para pedidos nuevos (por identificador: una reconexión no repite el aviso).
        var ids = _tickets!.Select(t => t.Id).ToHashSet();
        var hasNew = !_firstLoad && ids.Any(id => !_known.Contains(id));
        _known = ids;
        _firstLoad = false;
        if (hasNew && _sound)
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./kds.js");
                await _module.InvokeVoidAsync("beep");
            }
            catch (JSException)
            {
                // Sin audio: el aviso visual basta.
            }
        }
    }

    private async Task SetStationAsync(PreparationStation? station)
    {
        _station = station;
        _firstLoad = true;
        await LoadAsync();
    }

    private async Task AdvanceAsync(KitchenTicketView ticket)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var next = ticket.Status switch
            {
                KitchenTicketStatus.Pending => KitchenTicketStatus.Preparing,
                KitchenTicketStatus.Preparing => KitchenTicketStatus.Ready,
                _ => KitchenTicketStatus.Delivered,
            };
            var result = await Runner.RunAsync<KitchenService>((s, ct) => s.AdvanceAsync(ticket.Id, next, ct));
            _error = result.Error;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string NextLabel(KitchenTicketStatus status) => status switch
    {
        KitchenTicketStatus.Pending => "Empezar a preparar",
        KitchenTicketStatus.Preparing => "Marcar como listo",
        _ => "Entregado",
    };

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        _subscription?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró.
            }
        }
    }
}
