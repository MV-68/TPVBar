<Project>

  <!-- Propiedades comunes a todos los proyectos de TPVBar. Ver DECISIONS.md (D-002, D-005). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>es-ES</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Product>TPVBar</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Análisis estático y estilo: los avisos rompen la compilación. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
